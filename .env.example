# Public, non-secret configuration
APP_DOMAIN=leadflow.example.com
ACME_EMAIL=administrator@example.com
MYSQL_DATABASE=leadflow
DB_USERNAME=leadflow_app
N8N_EXECUTIONS_DATA_MAX_AGE_HOURS=168
N8N_EXECUTIONS_DATA_PRUNE_MAX_COUNT=1000

# Runtime secrets: generate unique random values before deployment.
DB_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
AUTOMATION_API_KEY=replace-with-a-random-automation-key
N8N_ENCRYPTION_KEY=replace-with-a-random-n8n-encryption-key

# Optional JVM tuning; never put credentials here.
JAVA_OPTS=-XX:MaxRAMPercentage=70.0 -XX:+ExitOnOutOfMemoryError -Duser.timezone=UTC

# ADMIN_BOOTSTRAP_PASSWORD is intentionally absent. The bootstrap script prompts for it.
